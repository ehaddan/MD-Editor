{
  "name": "eric-haddan-markdown-editor",
  "displayName": "Hugo Markdown WYSIWYG Editor",
  "description": "Visual Markdown editor with WYSIWYG editing, Hugo shortcodes, theme CSS previews, tables, images, and syntax highlighting.",
  "version": "0.8.4",
  "publisher": "eric-haddan",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE.txt",
  "pricing": "Free",
  "author": {
    "name": "Eric Haddan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehaddan/MD-Editor.git"
  },
  "homepage": "https://github.com/ehaddan/MD-Editor#readme",
  "bugs": {
    "url": "https://github.com/ehaddan/MD-Editor/issues"
  },
  "qna": "https://github.com/ehaddan/MD-Editor/issues",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "md",
    "hugo",
    "wysiwyg",
    "shortcode",
    "shortcodes",
    "hugo editor",
    "markdown editor",
    "visual markdown",
    "markdown preview",
    "markdown reader",
    "static site generator",
    "front matter",
    "table editor",
    "pipe tables",
    "documentation",
    "docs",
    "content editor",
    "go template",
    "theme css",
    "image editor",
    "syntax highlighting",
    "autocomplete"
  ],
  "galleryBanner": {
    "color": "#14213d",
    "theme": "dark"
  },
  "activationEvents": [
    "onCustomEditor:ericHaddan.markdownEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "ericHaddan.markdownEditor",
        "displayName": "Hugo Markdown WYSIWYG Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ericHaddan.markdownEditor.open",
        "title": "Open with Hugo Markdown WYSIWYG Editor"
      }
    ],
    "configuration": {
      "title": "Hugo Markdown WYSIWYG Editor",
      "properties": {
        "ericHaddan.markdownEditor.enableShortcodeInspector": {
          "type": "boolean",
          "default": false,
          "description": "Show generated HTML, computed CSS, and matched theme CSS rules when hovering over rendered Hugo shortcodes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.5.0"
  }
}
