{
  "name": "eric-haddan-markdown-editor",
  "displayName": "Markdown WYSIWYG Editor with Hugo Support",
  "description": "Edit Markdown visually or as syntax-highlighted text, with tables, images, code blocks, and built-in Hugo shortcode support.",
  "version": "0.8.6",
  "publisher": "eric-haddan",
  "icon": "icon.png",
  "license": "SEE LICENSE IN LICENSE.txt",
  "pricing": "Free",
  "author": {
    "name": "Eric Haddan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ehaddan/MD-Editor.git"
  },
  "homepage": "https://github.com/ehaddan/MD-Editor#readme",
  "bugs": {
    "url": "https://github.com/ehaddan/MD-Editor/issues"
  },
  "qna": "https://github.com/ehaddan/MD-Editor/issues",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "markdown",
    "md",
    "markdown editor",
    "wysiwyg",
    "visual markdown",
    "markdown preview",
    "markdown reader",
    "markdown viewer",
    "md editor",
    "table editor",
    "pipe tables",
    "documentation",
    "docs",
    "content editor",
    "image editor",
    "syntax highlighting",
    "autocomplete",
    "hugo",
    "hugo editor",
    "shortcode",
    "shortcodes",
    "front matter",
    "static site generator",
    "go template",
    "theme css"
  ],
  "galleryBanner": {
    "color": "#14213d",
    "theme": "dark"
  },
  "activationEvents": [
    "onCustomEditor:ericHaddan.markdownEditor"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "ericHaddan.markdownEditor",
        "displayName": "Markdown WYSIWYG Editor",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "ericHaddan.markdownEditor.open",
        "title": "Open with Markdown WYSIWYG Editor"
      }
    ],
    "configuration": {
      "title": "Markdown WYSIWYG Editor",
      "properties": {
        "ericHaddan.markdownEditor.enableShortcodeInspector": {
          "type": "boolean",
          "default": false,
          "description": "Show generated HTML, computed CSS, and matched theme CSS rules when hovering over rendered Hugo shortcodes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.6.2",
    "typescript": "^5.5.0"
  }
}
